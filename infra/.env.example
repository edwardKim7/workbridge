# 로컬 개발 예시입니다. scripts/initialize-env.ps1은 infra/.env에 임의 값을 생성합니다.
DB_NAME=workbridge
DB_USERNAME=workbridge
DB_PASSWORD=replace-with-random-local-password
DB_ROOT_PASSWORD=replace-with-random-root-password

# 기본값은 웹 서버를 이 PC에서만 열어 둡니다.
BIND_ADDRESS=127.0.0.1
SERVER_PORT=8080

# JWT HMAC 키는 UTF-8 기준 32바이트 이상이어야 합니다.
JWT_SECRET=replace-with-random-jwt-secret-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

LOGIN_MAX_FAILURES=5
LOGIN_LOCK_DURATION=15m
SESSION_COOKIE_SECURE=false

ERP_CONNECT_TIMEOUT=2s
ERP_READ_TIMEOUT=3s
ERP_MAX_ATTEMPTS=2
ERP_RETRY_BACKOFF=250ms
