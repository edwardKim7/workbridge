<%@ page pageEncoding="UTF-8" %>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="WorkBridge 사내 영업지원·전자결재 웹·모바일 통합 업무시스템">
<c:if test="${not empty _csrf}">
    <meta name="_csrf" content="<c:out value='${_csrf.token}'/>">
    <meta name="_csrf_header" content="<c:out value='${_csrf.headerName}'/>">
</c:if>
<link rel="stylesheet" href="<c:url value='/css/workbridge.css'/>">
