<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<header class="topbar">
    <a class="brand" href="<c:url value='/web/dashboard'/>" aria-label="WorkBridge 홈">
        <span class="brand-mark" aria-hidden="true">WB</span>
        <span>
            <strong><c:out value="${appName}" default="WorkBridge"/></strong>
            <small>Sales &amp; Approval Workspace</small>
        </span>
    </a>
    <div class="topbar-actions">
        <div class="user-summary">
            <span class="user-avatar"><c:out value="${fn:substring(currentUser.employeeName, 0, 1)}"/></span>
            <span>
                <strong><c:out value="${currentUser.employeeName}"/></strong>
                <small><c:out value="${currentUser.departmentName}"/> · <c:out value="${currentUser.employeeNo}"/></small>
            </span>
        </div>
        <form class="logout-form" action="<c:url value='/logout'/>" method="post">
            <input type="hidden" name="<c:out value='${_csrf.parameterName}'/>" value="<c:out value='${_csrf.token}'/>">
            <button type="submit" class="button button-ghost">로그아웃</button>
        </form>
    </div>
</header>
