<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.workbridge.server.mapper.audit.AuditLogMapper">
  <insert id="insert">INSERT INTO audit_log(actor_id,action,target_type,target_id,before_data,after_data,client_ip,user_agent,trace_id,created_at)VALUES(#{actorId},#{action},#{targetType},#{targetId},#{beforeData},#{afterData},#{clientIp},#{userAgent},#{traceId},CURRENT_TIMESTAMP)</insert>
  <sql id="auditSelect">SELECT a.*,e.employee_name actor_name FROM audit_log a LEFT JOIN employee e ON e.employee_id=a.actor_id</sql>
  <sql id="filter">
    <where>
      <if test="action!=null and action!=''">AND a.action=#{action}</if>
      <if test="traceId!=null and traceId!=''">AND a.trace_id=#{traceId}</if>
    </where>
  </sql>
  <select id="selectPage" resultType="com.workbridge.server.domain.operation.AuditLogRecord"><include refid="auditSelect"/><include refid="filter"/>ORDER BY a.audit_id DESC LIMIT #{size} OFFSET #{offset}</select>
  <select id="countPage" resultType="long">SELECT COUNT(*) FROM audit_log a <include refid="filter"/></select>
  <select id="selectRecent" resultType="com.workbridge.server.domain.operation.AuditLogRecord"><include refid="auditSelect"/>ORDER BY a.audit_id DESC LIMIT #{limit}</select>
  <select id="selectRecentLoginFailures" resultType="com.workbridge.server.domain.operation.AuditLogRecord"><include refid="auditSelect"/>WHERE a.action IN ('LOGIN_FAILURE','MOBILE_LOGIN_FAILURE') ORDER BY a.audit_id DESC LIMIT #{limit}</select>
</mapper>
